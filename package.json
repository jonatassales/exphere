{
  "name": "agentic-software-factory",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "check": "biome check .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "harness:score": "harness-score",
    "test": "turbo run test test:hooks",
    "test:hooks": "sh .husky/tests.sh",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@exphere/ex": "workspace:*",
    "harness-score": "1.8.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "turbo": "2.11.7"
  },
  "engines": {
    "node": ">=22.22.1"
  }
}
