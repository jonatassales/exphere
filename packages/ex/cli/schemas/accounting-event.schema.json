{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:exphere:consumer-harness:accounting-event:1",
  "title": "Accounting audit/export event v1; not a transactional ledger",
  "$comment": "Reference contract v1. Offline validation supports only the documented bundled vocabulary; no execution authorization is conveyed.",
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "eventId": {
      "$ref": "#/$defs/id"
    },
    "attemptId": {
      "$ref": "#/$defs/id"
    },
    "accountId": {
      "$ref": "#/$defs/id"
    },
    "cycleId": {
      "$ref": "#/$defs/id"
    },
    "featureId": {
      "$ref": "#/$defs/id"
    },
    "runtimeId": {
      "$ref": "#/$defs/id"
    },
    "ticketId": {
      "$ref": "#/$defs/id"
    },
    "category": {
      "enum": ["ai", "infrastructure"]
    },
    "purpose": {
      "enum": ["ordinary", "planning", "verification", "cleanup"]
    },
    "eventType": {
      "enum": ["reserved", "pending", "metered", "reconciled", "released"]
    },
    "amountMicros": {
      "$ref": "#/$defs/money"
    },
    "currency": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3,
      "pattern": "^[A-Z]{3}$"
    },
    "priceRevision": {
      "$ref": "#/$defs/revision"
    },
    "evidence": {
      "enum": [
        "synthetic-reservation",
        "synthetic-timeout",
        "synthetic-usage",
        "synthetic-invoice",
        "synthetic-confirmed-no-charge"
      ]
    }
  },
  "required": [
    "formatVersion",
    "synthetic",
    "eventId",
    "attemptId",
    "accountId",
    "cycleId",
    "featureId",
    "runtimeId",
    "ticketId",
    "category",
    "purpose",
    "eventType",
    "amountMicros",
    "currency",
    "priceRevision",
    "evidence"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\u0000-\u001f\u007f]).*[^/]$"
    },
    "money": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12,
      "pattern": "^(0|[1-9][0-9]{0,11})$"
    },
    "hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "time": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
