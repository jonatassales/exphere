{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "website",
    "namespace": "website-preview",
    "labels": {
      "app.kubernetes.io/name": "website",
      "exphere.io/runtime": "website-preview"
    }
  },
  "spec": {
    "replicas": 1,
    "selector": {
      "matchLabels": {
        "app.kubernetes.io/name": "website",
        "exphere.io/runtime": "website-preview"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/name": "website",
          "exphere.io/runtime": "website-preview"
        }
      },
      "spec": {
        "containers": [
          {
            "name": "website",
            "image": "exphere-fixture-website:local",
            "imagePullPolicy": "Never",
            "ports": [
              {
                "containerPort": 3000
              }
            ],
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "128Mi",
                "ephemeral-storage": "64Mi"
              },
              "limits": {
                "cpu": "200m",
                "memory": "256Mi",
                "ephemeral-storage": "128Mi"
              }
            },
            "readinessProbe": {
              "httpGet": {
                "path": "/",
                "port": 3000
              },
              "initialDelaySeconds": 1,
              "periodSeconds": 5
            }
          }
        ]
      }
    }
  }
}
