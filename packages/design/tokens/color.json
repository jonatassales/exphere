{
  "color": {
    "$type": "color",
    "gray": {
      "50": { "$value": "#fafafa" },
      "100": { "$value": "#f5f5f5" },
      "200": { "$value": "#e5e5e5" },
      "800": { "$value": "#262626" },
      "900": { "$value": "#171717" },
      "950": { "$value": "#0a0a0a" }
    }
  },
  "themes": {
    "light": {
      "color": {
        "$type": "color",
        "primary": { "$value": "#6D0AD6" },
        "primaryHover": { "$value": "#5408A5" },
        "background": { "$value": "#FFFFFF" },
        "surface": { "$value": "#F9F9F9" },
        "text": { "$value": "#27262A" },
        "textSecondary": { "$value": "#535257" },
        "border": { "$value": "#DDDDDD" },
        "foreground": { "$value": "{themes.light.color.text}" }
      }
    },
    "dark": {
      "color": {
        "$type": "color",
        "background": { "$value": "{color.gray.950}" },
        "foreground": { "$value": "{color.gray.50}" },
        "surface": { "$value": "{color.gray.900}" },
        "border": { "$value": "{color.gray.800}" }
      }
    }
  }
}
