{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:exphere:consumer-harness:cycle-context:1",
  "title": "Cycle attribution and context snapshot v1",
  "$comment": "Reference contract v1. Offline validation supports only the documented bundled vocabulary; no execution authorization is conveyed.",
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "cycleId": {
      "$ref": "#/$defs/id"
    },
    "repositoryId": {
      "$ref": "#/$defs/id"
    },
    "featureId": {
      "$ref": "#/$defs/id"
    },
    "ticketId": {
      "$ref": "#/$defs/id"
    },
    "runtimeId": {
      "$ref": "#/$defs/id"
    },
    "accountId": {
      "$ref": "#/$defs/id"
    },
    "codeRevision": {
      "$ref": "#/$defs/revision"
    },
    "configSha256": {
      "$ref": "#/$defs/hash"
    },
    "policyRevision": {
      "$ref": "#/$defs/revision"
    },
    "priceRevision": {
      "$ref": "#/$defs/revision"
    },
    "observedAt": {
      "$ref": "#/$defs/time"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "path": {
            "$ref": "#/$defs/path"
          },
          "repositoryId": {
            "$ref": "#/$defs/id"
          },
          "runtimeId": {
            "$ref": "#/$defs/id"
          },
          "revision": {
            "$ref": "#/$defs/revision"
          },
          "sha256": {
            "$ref": "#/$defs/hash"
          }
        },
        "required": [
          "id",
          "path",
          "repositoryId",
          "runtimeId",
          "revision",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 32
    },
    "graph": {
      "type": "object",
      "properties": {
        "threadId": {
          "$ref": "#/$defs/id"
        },
        "checkpointRef": {
          "$ref": "#/$defs/revision"
        },
        "storeId": {
          "$ref": "#/$defs/id"
        },
        "driver": {
          "const": "unselected"
        }
      },
      "required": [
        "threadId",
        "checkpointRef",
        "storeId",
        "driver"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "workflowStage": {
          "enum": [
            "captured",
            "discovery",
            "proposed",
            "specified",
            "ready",
            "implementing",
            "verifying",
            "delivery-approved",
            "observing",
            "reviewed"
          ]
        },
        "ticketState": {
          "enum": [
            "draft",
            "ready-for-agent",
            "in-progress",
            "in-review",
            "done",
            "blocked"
          ]
        },
        "runtimeState": {
          "enum": [
            "not-started",
            "running",
            "stopped",
            "cleanup-pending"
          ]
        },
        "financialState": {
          "enum": [
            "none",
            "pending",
            "metered",
            "reconciled"
          ]
        }
      },
      "required": [
        "workflowStage",
        "ticketState",
        "runtimeState",
        "financialState"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "formatVersion",
    "synthetic",
    "cycleId",
    "repositoryId",
    "featureId",
    "ticketId",
    "runtimeId",
    "accountId",
    "codeRevision",
    "configSha256",
    "policyRevision",
    "priceRevision",
    "observedAt",
    "sources",
    "graph",
    "state"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\u0000-\u001f\u007f]).*[^/]$"
    },
    "money": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12,
      "pattern": "^(0|[1-9][0-9]{0,11})$"
    },
    "hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "time": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
