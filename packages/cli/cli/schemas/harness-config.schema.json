{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:exphere:consumer-harness:harness-config:1",
  "title": "Consumer configuration v1",
  "$comment": "Reference contract v1. Offline validation supports only the documented bundled vocabulary; no execution authorization is conveyed.",
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "kind": {
      "const": "consumer-harness"
    },
    "referenceVersion": {
      "const": "1.0.0"
    },
    "repositoryId": {
      "$ref": "#/$defs/id"
    },
    "referenceBase": {
      "const": "consumer-root"
    },
    "selected": {
      "type": "object",
      "properties": {
        "workflowRef": {
          "$ref": "#/$defs/path"
        },
        "agentRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        },
        "guideRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "sensorsRef": {
          "$ref": "#/$defs/path"
        },
        "skillRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "runtimes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "descriptorRef": {
                "$ref": "#/$defs/path"
              }
            },
            "required": [
              "id",
              "descriptorRef"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 16
        }
      },
      "required": [
        "workflowRef",
        "agentRefs",
        "guideRefs",
        "sensorsRef",
        "skillRefs",
        "runtimes"
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "langgraph": {
          "enum": [
            "unavailable"
          ]
        },
        "mcp": {
          "enum": [
            "unavailable"
          ]
        },
        "rag": {
          "enum": [
            "unavailable"
          ]
        }
      },
      "required": [
        "langgraph",
        "mcp",
        "rag"
      ],
      "additionalProperties": false
    },
    "retrieval": {
      "type": "object",
      "properties": {
        "required": {
          "const": true
        },
        "corpora": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "path": {
                "$ref": "#/$defs/path"
              },
              "repositoryId": {
                "$ref": "#/$defs/id"
              },
              "runtimeId": {
                "$ref": "#/$defs/id"
              },
              "revision": {
                "$ref": "#/$defs/revision"
              },
              "sha256": {
                "$ref": "#/$defs/hash"
              }
            },
            "required": [
              "id",
              "path",
              "repositoryId",
              "runtimeId",
              "revision",
              "sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 16
        },
        "maxDocuments": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "maxContextTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "freshness": {
          "type": "object",
          "properties": {
            "revisionPolicy": {
              "const": "exact"
            },
            "maxAgeSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 604800
            }
          },
          "required": [
            "revisionPolicy",
            "maxAgeSeconds"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "required",
        "corpora",
        "maxDocuments",
        "maxContextTokens",
        "exclude",
        "freshness"
      ],
      "additionalProperties": false
    },
    "models": {
      "type": "object",
      "properties": {
        "catalogRevision": {
          "$ref": "#/$defs/revision"
        },
        "priceRevision": {
          "$ref": "#/$defs/revision"
        },
        "provenance": {
          "enum": [
            "synthetic",
            "governed"
          ]
        },
        "currency": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3,
          "pattern": "^[A-Z]{3}$"
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "provider": {
                "$ref": "#/$defs/id"
              },
              "model": {
                "$ref": "#/$defs/id"
              },
              "purpose": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "supportedEfforts": {
                "type": "array",
                "items": {
                  "enum": [
                    "none",
                    "low",
                    "medium",
                    "high"
                  ]
                },
                "minItems": 1,
                "maxItems": 4,
                "uniqueItems": true
              },
              "effortMapping": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "minProperties": 1,
                "maxProperties": 4
              },
              "inputMicrosPerToken": {
                "$ref": "#/$defs/money"
              },
              "outputMicrosPerToken": {
                "$ref": "#/$defs/money"
              },
              "maxOutputTokens": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "capabilitySourceRef": {
                "$ref": "#/$defs/path"
              }
            },
            "required": [
              "id",
              "provider",
              "model",
              "purpose",
              "supportedEfforts",
              "effortMapping",
              "maxOutputTokens",
              "capabilitySourceRef"
            ],
            "additionalProperties": false
          },
          "minItems": 2,
          "maxItems": 8
        }
      },
      "required": [
        "catalogRevision",
        "priceRevision",
        "provenance",
        "currency",
        "profiles"
      ],
      "additionalProperties": false
    },
    "bootstrap": {
      "type": "object",
      "properties": {
        "profileId": {
          "$ref": "#/$defs/id"
        },
        "effort": {
          "enum": [
            "none",
            "low",
            "medium",
            "high"
          ]
        },
        "allowanceMicros": {
          "$ref": "#/$defs/money"
        },
        "coveredPurposes": {
          "type": "array",
          "items": {
            "enum": [
              "embedding",
              "retrieval",
              "planning",
              "review",
              "diagnosis",
              "retry",
              "explanation"
            ]
          },
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true
        }
      },
      "required": [
        "profileId",
        "effort",
        "allowanceMicros",
        "coveredPurposes"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "policyRevision": {
          "$ref": "#/$defs/revision"
        },
        "currency": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3,
          "pattern": "^[A-Z]{3}$"
        },
        "unit": {
          "const": "microcurrency"
        },
        "scale": {
          "const": 6
        },
        "rounding": {
          "const": "ceil-reservation-half-up-observed"
        },
        "owner": {
          "$ref": "#/$defs/id"
        },
        "window": {
          "type": "object",
          "properties": {
            "start": {
              "$ref": "#/$defs/time"
            },
            "end": {
              "$ref": "#/$defs/time"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        "coverage": {
          "type": "object",
          "properties": {
            "ai": {
              "enum": [
                "bounded",
                "unknown"
              ]
            },
            "infrastructure": {
              "enum": [
                "allocation-estimate",
                "unknown"
              ]
            },
            "other": {
              "enum": [
                "excluded",
                "unknown"
              ]
            }
          },
          "required": [
            "ai",
            "infrastructure",
            "other"
          ],
          "additionalProperties": false
        },
        "failureBehavior": {
          "const": "reject-unknown-or-unbounded"
        },
        "accounts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "parentId": {
                "$ref": "#/$defs/id"
              },
              "kind": {
                "enum": [
                  "funding-window",
                  "feature",
                  "cycle"
                ]
              },
              "caps": {
                "type": "object",
                "properties": {
                  "ai": {
                    "$ref": "#/$defs/money"
                  },
                  "infrastructure": {
                    "$ref": "#/$defs/money"
                  },
                  "combined": {
                    "$ref": "#/$defs/money"
                  }
                },
                "required": [
                  "ai",
                  "infrastructure",
                  "combined"
                ],
                "additionalProperties": false
              },
              "protected": {
                "type": "object",
                "properties": {
                  "ai": {
                    "$ref": "#/$defs/money"
                  },
                  "infrastructure": {
                    "$ref": "#/$defs/money"
                  },
                  "combined": {
                    "$ref": "#/$defs/money"
                  }
                },
                "required": [
                  "ai",
                  "infrastructure",
                  "combined"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "kind",
              "caps",
              "protected"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 16
        }
      },
      "required": [
        "policyRevision",
        "currency",
        "unit",
        "scale",
        "rounding",
        "owner",
        "window",
        "coverage",
        "failureBehavior",
        "accounts"
      ],
      "additionalProperties": false
    },
    "infrastructure": {
      "type": "object",
      "properties": {
        "valuation": {
          "const": "allocation-estimate"
        },
        "horizonSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "maxLifetimeSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "inspectionSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "shutdownAuthority": {
          "$ref": "#/$defs/id"
        },
        "residualCosts": {
          "type": "array",
          "items": {
            "enum": [
              "storage",
              "network"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "cleanupRequired": {
          "const": true
        },
        "rateRevision": {
          "$ref": "#/$defs/revision"
        },
        "hourlyAllocationMicros": {
          "$ref": "#/$defs/money"
        },
        "hardCapSupported": {
          "const": false
        }
      },
      "required": [
        "valuation",
        "horizonSeconds",
        "maxLifetimeSeconds",
        "inspectionSeconds",
        "shutdownAuthority",
        "residualCosts",
        "cleanupRequired",
        "rateRevision",
        "hourlyAllocationMicros",
        "hardCapSupported"
      ],
      "additionalProperties": false
    },
    "stores": {
      "type": "object",
      "properties": {
        "accounting": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "implementation": {
              "const": "unavailable"
            },
            "writer": {
              "enum": [
                "accounting-dispatcher",
                "graph-executor"
              ]
            },
            "path": {
              "$ref": "#/$defs/path"
            }
          },
          "required": [
            "id",
            "implementation",
            "writer",
            "path"
          ],
          "additionalProperties": false
        },
        "graph": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "implementation": {
              "const": "unavailable"
            },
            "writer": {
              "enum": [
                "accounting-dispatcher",
                "graph-executor"
              ]
            },
            "path": {
              "$ref": "#/$defs/path"
            }
          },
          "required": [
            "id",
            "implementation",
            "writer",
            "path"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "accounting",
        "graph"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "formatVersion",
    "synthetic",
    "kind",
    "referenceVersion",
    "repositoryId",
    "referenceBase",
    "selected",
    "capabilities",
    "retrieval",
    "models",
    "bootstrap",
    "budget",
    "infrastructure",
    "stores"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\u0000-\u001f\u007f]).*[^/]$"
    },
    "money": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12,
      "pattern": "^(0|[1-9][0-9]{0,11})$"
    },
    "hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "time": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
