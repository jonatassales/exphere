{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:exphere:consumer-harness:cycle-event:1",
  "title": "Cycle observations v1",
  "$comment": "Reference contract v1. Offline validation supports only the documented bundled vocabulary; no execution authorization is conveyed.",
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "eventId": {
      "$ref": "#/$defs/id"
    },
    "cycleId": {
      "$ref": "#/$defs/id"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "eventType": {
      "enum": [
        "planned",
        "paused",
        "resumed",
        "verification",
        "cleanup-required",
        "ended"
      ]
    },
    "result": {
      "enum": ["passed", "failed", "inconclusive"]
    },
    "resourceObligations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "resourceId": {
            "$ref": "#/$defs/id"
          },
          "owner": {
            "$ref": "#/$defs/id"
          },
          "status": {
            "enum": ["ongoing", "retained", "cleanup-failed"]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "shutdownAuthority": {
            "$ref": "#/$defs/id"
          },
          "maxLifetimeSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 604800
          }
        },
        "required": [
          "resourceId",
          "owner",
          "status",
          "reason",
          "shutdownAuthority",
          "maxLifetimeSeconds"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 32
    }
  },
  "required": [
    "formatVersion",
    "synthetic",
    "eventId",
    "cycleId",
    "sequence",
    "eventType",
    "result",
    "resourceObligations"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\u0000-\u001f\u007f]).*[^/]$"
    },
    "money": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12,
      "pattern": "^(0|[1-9][0-9]{0,11})$"
    },
    "hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "time": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
