{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:exphere:consumer-harness:harness-workflow:1",
  "title": "Selected SDD workflow v1",
  "$comment": "Reference contract v1. Offline validation supports only the documented bundled vocabulary; no execution authorization is conveyed.",
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "architecture": {
      "const": "spec-driven-development"
    },
    "executable": {
      "const": false
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "enum": [
              "captured",
              "discovery",
              "proposed",
              "specified",
              "ready",
              "implementing",
              "verifying",
              "delivery-approved",
              "observing",
              "reviewed"
            ]
          },
          "skillRefs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/path"
            },
            "minItems": 0,
            "maxItems": 16
          },
          "templateRefs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/path"
            },
            "minItems": 0,
            "maxItems": 16
          },
          "guideRefs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/path"
            },
            "minItems": 0,
            "maxItems": 16
          },
          "checkIds": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "minItems": 0,
            "maxItems": 16
          },
          "requiredEvidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "minItems": 1,
            "maxItems": 16
          }
        },
        "required": [
          "id",
          "skillRefs",
          "templateRefs",
          "guideRefs",
          "checkIds",
          "requiredEvidence"
        ],
        "additionalProperties": false
      },
      "minItems": 10,
      "maxItems": 10
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "enum": [
              "captured",
              "discovery",
              "proposed",
              "specified",
              "ready",
              "implementing",
              "verifying",
              "delivery-approved",
              "observing",
              "reviewed"
            ]
          },
          "to": {
            "enum": [
              "captured",
              "discovery",
              "proposed",
              "specified",
              "ready",
              "implementing",
              "verifying",
              "delivery-approved",
              "observing",
              "reviewed"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      },
      "minItems": 9,
      "maxItems": 32
    },
    "blocking": {
      "type": "object",
      "properties": {
        "preserveStage": {
          "const": true
        },
        "requires": {
          "const": [
            "reason",
            "resumeCondition"
          ]
        }
      },
      "required": [
        "preserveStage",
        "requires"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "formatVersion",
    "id",
    "architecture",
    "executable",
    "stages",
    "transitions",
    "blocking"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\u0000-\u001f\u007f]).*[^/]$"
    },
    "money": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12,
      "pattern": "^(0|[1-9][0-9]{0,11})$"
    },
    "hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "time": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
