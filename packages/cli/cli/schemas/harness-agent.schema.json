{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:exphere:consumer-harness:harness-agent:1",
  "title": "Planner bindings v1",
  "$comment": "Reference contract v1. Offline validation supports only the documented bundled vocabulary; no execution authorization is conveyed.",
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "role": {
      "enum": ["planner", "diagnostician"]
    },
    "orchestrator": {
      "const": "langgraph"
    },
    "availability": {
      "const": "unavailable"
    },
    "bootstrapProfileId": {
      "$ref": "#/$defs/id"
    },
    "allowedProfileIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "minItems": 2,
      "maxItems": 8,
      "uniqueItems": true
    },
    "retrievalRequired": {
      "const": true
    },
    "outputContract": {
      "const": "execution-plan-v1"
    },
    "canChangePolicy": {
      "const": false
    },
    "toolBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "protocol": {
            "const": "mcp"
          },
          "availability": {
            "const": "unavailable"
          },
          "operations": {
            "type": "array",
            "items": {
              "enum": ["read", "propose"]
            },
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true
          },
          "repositoryId": {
            "$ref": "#/$defs/id"
          },
          "runtimeId": {
            "$ref": "#/$defs/id"
          }
        },
        "required": [
          "id",
          "protocol",
          "availability",
          "operations",
          "repositoryId",
          "runtimeId"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 16
    }
  },
  "required": [
    "formatVersion",
    "id",
    "role",
    "orchestrator",
    "availability",
    "bootstrapProfileId",
    "allowedProfileIds",
    "retrievalRequired",
    "outputContract",
    "canChangePolicy",
    "toolBindings"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\u0000-\u001f\u007f]).*[^/]$"
    },
    "money": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12,
      "pattern": "^(0|[1-9][0-9]{0,11})$"
    },
    "hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "time": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
