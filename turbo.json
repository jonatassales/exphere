{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "//#test:hooks": {
      "cache": false
    },
    "@exphere/cli#build": {
      "outputs": ["dist/**"],
      "cache": false
    },
    "@exphere/cli#typecheck": {
      "cache": false
    },
    "test:contracts": {
      "cache": false
    }
  }
}
